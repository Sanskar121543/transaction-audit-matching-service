# Copy this file to .env (which is gitignored) and change the values.
# Everything here is a local-only demo credential for synthetic data. Nothing in this project uses an AI key.

# Host ports, bound to 127.0.0.1 only. They differ from the Payments Ledger Service's ports, but never run
# both stacks at once anyway: together they do not fit in the memory Docker has on a 16 GB laptop.
HTTP_PORT=8089
POSTGRES_PORT=5433

POSTGRES_USER=reconciliation
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=reconciliation

# Clients send a key in the X-API-Key header; the app only knows SHA-256 hashes (API_KEY_HASHES).
# OPERATOR_API_KEY is for the dashboard and uploads. READONLY_API_KEY is what the MCP server uses: it can
# read, and it cannot change any record. Generate your own pair with: scripts/new-api-key.sh
OPERATOR_API_KEY=tams_ops_c7fd845f226d6622874ebd84c5f8d3c4
READONLY_API_KEY=tams_mcp_7662927d85731a46cbffb9208629e824
API_KEY_HASHES=ops:operator:1cc2ae7a381315e9a6c60d156f13ba5fc8f626e10dcd8bfba861efd84edb64c1,mcp:readonly:b75a4bab8f583657d19a984fd66039637c81938165f502d924d6f7ceb17911fa
